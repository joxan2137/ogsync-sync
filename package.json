{
  "name": "ogsync",
  "version": "0.1.0",
  "description": "AI agent framework for Roblox Studio: token-lean MCP server + two-way live sync + self-installing Studio plugin",
  "type": "module",
  "private": true,
  "engines": { "bun": "1.3.14" },
  "scripts": {
    "dev": "bun run server/src/index.ts serve",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:plugin": "lune run plugin/tests/sync_guards.test",
    "build:plugin": "rojo build plugin -o dist/OGSync.rbxm",
    "build:embed": "bun run scripts/embed-plugin.ts",
    "build:bin": "bun run scripts/build-binaries.ts",
    "build": "bun run build:plugin && bun run build:embed && bun run build:bin"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.6.0"
  }
}
